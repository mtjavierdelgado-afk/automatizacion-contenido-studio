#!/usr/bin/env bash
# -----------------------------------------------------------------------------
#  asvs — el mando de Automatización Contenido Studio en el servidor.
#
#  Existe para que, cuando algo va raro, la respuesta a «¿que hago?» sea una
#  palabra y no un parrafo de comandos de systemd.
#
#      asvs estado       como esta todo (esto es lo que hay que mandar si pides ayuda)
#      asvs registro     que ha dicho el estudio ultimamente
#      asvs reiniciar    apagar y encender
#      asvs actualizar   traer la ultima version (sin tocar tus videos)
#                        (no para una tanda en marcha; --forzar para hacerlo)
#      asvs clave        ver o cambiar la contrasena de acceso
#      asvs https        (re)intentar el certificado
#      asvs repositorio  de donde se baja el codigo (y cambiarlo: asvs repositorio usuario/repo)
#      asvs probar       la prueba real: un video de 30 s con tus claves (~1 $), comprobado solo;
#                        si la consola se corta sigue sola, y repetirlo la vuelve a enseñar o la retoma
# -----------------------------------------------------------------------------
set -euo pipefail

RAIZ="${ASVS_RAIZ:-/opt/as-video-studio}"
# DE DONDE SE BAJA EL CODIGO, por este orden: ASVS_REPO si se pasa, lo que
# diga $RAIZ/datos/repositorio (lo escribe el instalador y `asvs repositorio`),
# y si no, el de fabrica. Vive en datos/ y no en el codigo a proposito:
# actualizar reemplaza el codigo entero y no puede olvidarse de donde viene.
FICHERO_REPO="$RAIZ/datos/repositorio"
REPO_GUARDADO="$( { tr -d '[:space:]' < "$FICHERO_REPO"; } 2>/dev/null || true)"
REPO="${ASVS_REPO:-${REPO_GUARDADO:-mtjavierdelgado-afk/automatizacion-contenido-studio}}"
RAMA="${ASVS_RAMA:-main}"
USUARIO="${ASVS_USUARIO:-studio}"

if [ -t 1 ]; then N=$'\033[0m'; B=$'\033[1m'; VERDE=$'\033[32m'; ROJO=$'\033[31m'; GRIS=$'\033[90m'
else N=""; B=""; VERDE=""; ROJO=""; GRIS=""; fi

si() { printf '  %s✓%s %s\n' "$VERDE" "$N" "$*"; }
no() { printf '  %s✗%s %s\n' "$ROJO" "$N" "$*"; }

[ "$(id -u)" -eq 0 ] || { echo "Hay que ser root."; exit 1; }

_puerto() { sed -n 's/^PUERTO=//p' "$RAIZ/datos/entorno" 2>/dev/null | head -1; }
_dominio() { sed -n 's|^APP_URL=https\?://||p' "$RAIZ/login/.env" 2>/dev/null | head -1; }
# Y por que esquema se entra. Se lee del .env y no se da por supuesto https: una
# instalacion sin certificado va por http, y comprobarla con https daba un fallo
# que no lo era -- el propio estado decia que estaba roto lo que funcionaba.
_esquema() { grep -m1 '^APP_URL=' "$RAIZ/login/.env" 2>/dev/null | sed 's|^APP_URL=||' | cut -d: -f1; }

estado() {
  local puerto dominio esquema codigo
  puerto="$(_puerto)"; dominio="$(_dominio)"; esquema="$(_esquema)"
  [ -n "$esquema" ] || esquema=https

  printf '\n%s  Automatización Contenido Studio%s   %s%s://%s%s\n\n' "$B" "$N" "$GRIS" "$esquema" "$dominio" "$N"

  systemctl is-active --quiet as-video-studio && si "el estudio esta en marcha" || no "el estudio esta PARADO"
  systemctl is-active --quiet as-video-login  && si "el acceso esta en marcha"  || no "el acceso esta PARADO"
  systemctl is-active --quiet nginx           && si "el servidor web esta en marcha" || no "el servidor web esta PARADO"

  curl -fsS --max-time 5 "http://127.0.0.1:${puerto:-8110}/api/salud" >/dev/null 2>&1 \
    && si "el estudio contesta" || no "el estudio no contesta por dentro"

  codigo="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 -k "$esquema://$dominio/login" 2>/dev/null || true)"
  [ "$codigo" = "200" ] && si "la pantalla de acceso se ve desde fuera" || no "la pantalla de acceso contesta $codigo"

  printf '\n%s  lo que hace falta para generar%s\n' "$B" "$N"
  command -v ffmpeg >/dev/null && si "ffmpeg $(ffmpeg -version 2>/dev/null | head -1 | awk '{print $3}')" || no "falta ffmpeg"
  [ -x /usr/local/bin/estudio-edge ] && si "navegador: $(/usr/local/bin/estudio-edge --version 2>/dev/null | head -1)" || no "falta el navegador"
  command -v claude >/dev/null && si "CLI de Claude $(claude --version 2>/dev/null | head -1)" || no "falta el CLI de Claude"

  # La comprobacion que no es obvia: que el fichero con el que se MIDE el texto
  # sea el mismo con el que se DIBUJA. Si se separan, los rotulos se salen de su
  # caja y no lo dice ningun error.
  local mide dibuja
  mide="$(readlink -f /usr/local/share/fonts/estudio/verdana.ttf 2>/dev/null || true)"
  dibuja="$(readlink -f "$(fc-match Verdana -f '%{file}' 2>/dev/null)" 2>/dev/null || true)"
  [ -n "$mide" ] && [ "$mide" = "$dibuja" ] \
    && si "fuentes: mide y dibuja $(basename "$mide")" \
    || no "fuentes descuadradas: mide $(basename "${mide:-nada}") y dibuja $(basename "${dibuja:-nada}")"

  printf '\n%s  espacio y datos%s\n' "$B" "$N"
  printf '  %s· %s libres en disco%s\n' "$GRIS" "$(df -h --output=avail "$RAIZ" 2>/dev/null | tail -1 | tr -d ' ')" "$N"
  printf '  %s· %s videos, %s ocupados%s\n' "$GRIS" \
    "$(find "$RAIZ/datos/proyectos" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)" \
    "$(du -sh "$RAIZ/datos" 2>/dev/null | cut -f1)" "$N"
  printf '\n'
}

registro() {
  journalctl -u as-video-studio -u as-video-login -n "${1:-60}" --no-pager
}

reiniciar() {
  systemctl restart as-video-login as-video-studio
  sleep 2
  estado
}

# Cuantos trabajos estan corriendo ahora mismo. Vacio si no se puede saber
# (el estudio parado, o sin jq): quien llama lo trata como «ninguno».
_trabajos_activos() {
  local puerto
  puerto="$(_puerto)"
  curl -fsS --max-time 5 "http://127.0.0.1:${puerto:-8110}/api/trabajos?activos=1" 2>/dev/null \
    | jq -r '.trabajos | length' 2>/dev/null || true
}

# Donde se instalan los dos mandos. Variable solo para poder probar
# `actualizar` en una raiz falsa sin pisar los de verdad.
BIN="${ASVS_BIN:-/usr/local/bin}"

# El puerto del login, de su .env (3000 si no lo dice).
_puerto_login() { sed -n 's/^PORT=//p' "$RAIZ/login/.env" 2>/dev/null | head -1; }

# ¿Contestan los dos servicios? Espera hasta ~60 s: el estudio tarda en cargar
# los pasos. Devuelve 0 si los dos estan en marcha y contestan.
_contestan() {
  local i puerto login
  puerto="$(_puerto)"; login="$(_puerto_login)"
  for i in $(seq 1 30); do
    if systemctl is-active --quiet as-video-studio \
       && systemctl is-active --quiet as-video-login \
       && curl -fsS --max-time 5 "http://127.0.0.1:${puerto:-8110}/api/salud" >/dev/null 2>&1 \
       && curl -fsS --max-time 5 "http://127.0.0.1:${login:-3000}/api/health" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# Lo que se copia del codigo, en las dos direcciones (actualizar y deshacer).
EXCLUIR_CODIGO=(--exclude='.git' --exclude='__pycache__' --exclude='*.pyc' --exclude='node_modules/'
  --exclude='cache/' --exclude='proyectos/' --exclude='banco/' --exclude='secretos/'
  --exclude='motores/reglas/reglas.json')
EXCLUIR_LOGIN=(--exclude='datos' --exclude='.env')

actualizar() {
  local temporal forzar=0 activos anterior
  [ "${1:-}" = "--forzar" ] && forzar=1

  # PARAR EL SERVICIO MATA LA TANDA QUE ESTE CORRIENDO, y una tanda son
  # imagenes que ya se han pagado. Se pregunta antes de bajar nada.
  activos="$(_trabajos_activos)"
  if [ -n "$activos" ] && [ "$activos" -gt 0 ] && [ "$forzar" = 0 ]; then
    no "hay $activos trabajo(s) en marcha (una tanda de imagenes, un render...)."
    echo "  Actualizar ahora lo cortaria a medias. Espera a que acabe, o fuerza con:"
    echo "      asvs actualizar --forzar"
    exit 1
  fi

  temporal="$(mktemp -d)"
  echo "Bajando la ultima version de $REPO ($RAMA)..."
  curl -fsSL "https://codeload.github.com/$REPO/tar.gz/refs/heads/$RAMA" -o "$temporal/c.tgz" \
    || { no "no se ha podido bajar el codigo"; rm -rf "$temporal"; exit 1; }
  mkdir -p "$temporal/codigo"
  tar -xzf "$temporal/c.tgz" -C "$temporal/codigo" --strip-components=1
  [ -f "$temporal/codigo/app.py" ] || { echo "lo bajado no es el estudio"; rm -rf "$temporal"; exit 1; }

  # LAS LIBRERIAS, ANTES DE TOCAR NADA (revision 16-10-2026). Iban despues de
  # cambiar el codigo: un `pip install` sin red dejaba el codigo NUEVO con las
  # librerias VIEJAS, el estudio no arrancaba y la web daba 502. Y el `npm
  # install` del login se tragaba sus errores: un login que no arranca deja
  # fuera a todo el mundo. Aqui, si algo falla, el servidor sigue como estaba.
  echo "Instalando las librerias de Python..."
  "$RAIZ/venv/bin/pip" install --quiet -r "$temporal/codigo/requirements.txt" \
    || { no "pip no ha podido instalar las librerias: no se ha cambiado nada"; rm -rf "$temporal"; exit 1; }
  echo "Instalando las librerias del acceso..."
  # se parte de las que ya hay, para no bajarlas todas cada vez
  if [ -d "$RAIZ/login/node_modules" ]; then
    cp -a "$RAIZ/login/node_modules" "$temporal/codigo/despliegue/login/" 2>/dev/null || true
  fi
  ( cd "$temporal/codigo/despliegue/login" && npm install --omit=dev --no-audit --no-fund ) \
    > "$temporal/npm.log" 2>&1 \
    || { no "npm no ha podido instalar las librerias del acceso: no se ha cambiado nada"
         tail -n 15 "$temporal/npm.log" | sed 's/^/    /'; rm -rf "$temporal"; exit 1; }

  # LA COPIA DE LO QUE FUNCIONA, para poder volver. Fuera de app/ y sin la
  # cache: es lo que se restaura si algo sale mal de aqui en adelante.
  anterior="$RAIZ/anterior"
  rm -rf "$anterior"; mkdir -p "$anterior/app" "$anterior/login"
  rsync -a "${EXCLUIR_CODIGO[@]}" "$RAIZ/app/" "$anterior/app/"
  rsync -a "${EXCLUIR_LOGIN[@]}" "$RAIZ/login/" "$anterior/login/"

  # Y SI ALGO FALLA DE AQUI EN ADELANTE, se vuelve a lo que habia y se
  # arranca. Antes solo se re-arrancaba, con el codigo a medio cambiar.
  trap '_deshacer "$anterior"; rm -rf "$temporal"; exit 1' ERR
  # Se para antes de tocar nada: cambiar el codigo por debajo de una tanda que
  # esta corriendo es la forma mas rapida de perderla.
  systemctl stop as-video-studio
  # reglas.json va excluido a proposito: es lo unico del arbol de codigo que la
  # aplicacion reescribe (el destilador aprende de tu feedback y lo guarda ahi).
  # Sin excluirlo, actualizar borraria lo aprendido sin decir nada.
  rsync -a --delete "${EXCLUIR_CODIGO[@]}" "$temporal/codigo/" "$RAIZ/app/"
  [ -f "$RAIZ/app/motores/reglas/reglas.json" ] \
    || cp "$temporal/codigo/motores/reglas/reglas.json" "$RAIZ/app/motores/reglas/reglas.json"
  rsync -a --delete "${EXCLUIR_LOGIN[@]}" "$temporal/codigo/despliegue/login/" "$RAIZ/login/"
  chown -R "$USUARIO:$USUARIO" "$RAIZ/app" "$RAIZ/login"
  systemctl restart as-video-login as-video-studio
  trap - ERR

  # QUE ARRANQUE DE VERDAD. Si en un minuto no contesta, se deshace.
  if ! _contestan; then
    no "la version nueva no arranca: vuelvo a la que habia"
    _deshacer "$anterior"
    rm -rf "$temporal"
    exit 1
  fi
  rm -rf "$temporal"
  # Los mandos, solo con la version nueva en marcha: si se deshace, se quedan
  # los que iban con la vieja.
  install -m 755 "$RAIZ/app/despliegue/asvs" "$BIN/asvs"
  install -m 755 "$RAIZ/app/despliegue/estudio-clave" "$BIN/estudio-clave"
  # Se apunta de donde ha venido lo que acaba de instalarse: la proxima vez
  # se baja del mismo sitio aunque nadie pase ASVS_REPO.
  printf '%s\n' "$REPO" > "$FICHERO_REPO"
  echo
  estado
}

# Vuelve al codigo y al login de `anterior` y arranca. Las librerias de Python
# NO se deshacen (pip no sabe): el codigo viejo con librerias nuevas arranca
# en la practica, y al reves es lo que dejaba el servidor caido.
_deshacer() {
  local anterior="$1"
  trap - ERR
  echo
  no "deshaciendo la actualizacion: vuelve el codigo que habia"
  if [ -d "$anterior/app" ] && [ -f "$anterior/app/app.py" ]; then
    systemctl stop as-video-studio || true
    rsync -a --delete "${EXCLUIR_CODIGO[@]}" "$anterior/app/" "$RAIZ/app/" || true
    rsync -a --delete "${EXCLUIR_LOGIN[@]}" "$anterior/login/" "$RAIZ/login/" || true
    chown -R "$USUARIO:$USUARIO" "$RAIZ/app" "$RAIZ/login" || true
  fi
  systemctl restart as-video-login as-video-studio || true
  if _contestan; then
    si "el estudio vuelve a estar como antes de actualizar"
  else
    no "tampoco arranca la version anterior: mira  asvs registro"
  fi
}

repositorio() {
  local nuevo="${1:-}"
  if [ -z "$nuevo" ]; then
    echo "El codigo se baja de:  https://github.com/$REPO  (rama $RAMA)"
    echo "Para cambiarlo:        asvs repositorio usuario/repositorio"
    return
  fi
  # usuario/repositorio y nada mas: ni la URL entera ni barras de sobra
  nuevo="${nuevo#https://github.com/}"; nuevo="${nuevo%.git}"; nuevo="${nuevo%/}"
  printf '%s' "$nuevo" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' \
    || { no "«$1» no tiene la forma usuario/repositorio"; exit 1; }
  # Se comprueba ANTES de guardarlo: un nombre mal escrito haria fallar la
  # proxima actualizacion, y entonces nadie se acuerda de por que.
  curl -fsSIL --max-time 20 -o /dev/null \
       "https://codeload.github.com/$nuevo/tar.gz/refs/heads/$RAMA" \
    || { no "no encuentro https://github.com/$nuevo (rama $RAMA). Tiene que existir y ser publico."; exit 1; }
  printf '%s\n' "$nuevo" > "$FICHERO_REPO"
  si "a partir de ahora el codigo se baja de https://github.com/$nuevo"
  echo "  Para traerlo ya:  asvs actualizar"
}

https() {
  local dominio correo=(--register-unsafely-without-email)
  dominio="$(_dominio)"
  [ -n "${ASVS_CORREO:-}" ] && correo=(-m "$ASVS_CORREO")
  certbot --nginx -d "$dominio" --non-interactive --agree-tos --redirect \
    --keep-until-expiring "${correo[@]}"
  # Con certificado, la cookie de sesion vuelve a ser segura.
  sed -i 's|^SECURE_COOKIES=.*|SECURE_COOKIES=true|; s|^APP_URL=http://|APP_URL=https://|; s|^APP_ORIGENES=http://|APP_ORIGENES=https://|' \
    "$RAIZ/login/.env"
  systemctl restart as-video-login
  systemctl reload nginx
  echo "Listo: https://$dominio"
}

# LA PRUEBA REAL (herramientas/prueba_real.py): un video de prueba con las
# claves de verdad, comprobado de punta a punta. Corre como el usuario del
# servicio y con su entorno, igual que el Studio.
#
# DESLIGADA DE LA CONSOLA: la consola web de Hostinger se corta a menudo, y un
# corte mataba la prueba a medias. Se lanza con setsid/nohup y aqui solo se
# va enseñando su registro: si la consola se cae, la prueba sigue. Volver a
# escribir `asvs probar` la vuelve a enseñar si sigue viva, o la RETOMA donde
# se quedo (--seguir) si el proceso murio. `asvs probar nueva` empieza otra.
probar() {
  local puerto carpeta registro pidf pid seguir="--seguir"
  puerto="$(_puerto)"
  carpeta="$(grep -m1 '^ESTUDIO_PROYECTOS=' "$RAIZ/datos/entorno" 2>/dev/null | cut -d= -f2- || true)"
  carpeta="${carpeta:-$RAIZ/datos/proyectos}/_sistema/pruebas_reales"
  registro="$carpeta/registro.log"
  pidf="$carpeta/proceso.pid"
  if [ "${1:-}" = "nueva" ]; then seguir=""; shift; fi
  if [ "${1:-}" = "ver" ]; then shift; fi
  sudo -u "$USUARIO" mkdir -p "$carpeta"
  pid="$(cat "$pidf" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "La prueba real ya está corriendo (proceso $pid). Te enseño cómo va;"
    echo "si la consola se corta, sigue sola: vuelve a escribir  asvs probar  para verla."
  else
    if [ -n "$seguir" ] && [ -f "$carpeta/en_curso.json" ]; then
      echo "Hay una prueba real a medias: la sigo donde se quedó (sin volver a pagar lo hecho)."
    else
      echo "La prueba real gasta ~0,6-1 \$ (un video de 30 s en calidad baja) y tarda 15-25 min."
      echo "No toca tus videos: crea uno nuevo, «Prueba real <fecha>»."
    fi
    echo "Corre APARTE de esta consola: si se corta, sigue sola. Para volver a verla:  asvs probar"
    sudo -u "$USUARIO" bash -c "set -a; . '$RAIZ/datos/entorno'; set +a; cd '$RAIZ/app' && \
      PUERTO='${puerto:-8110}' setsid nohup '$RAIZ/venv/bin/python' -u herramientas/prueba_real.py \
      --api 'http://127.0.0.1:${puerto:-8110}' $seguir $* > '$registro' 2>&1 < /dev/null & echo \$! > '$pidf'"
    sleep 1
    pid="$(cat "$pidf" 2>/dev/null || true)"
  fi
  echo
  # enseña el registro hasta que la prueba acaba (Ctrl+C solo deja de mirar)
  tail -n +1 -f --pid="${pid:-1}" "$registro" 2>/dev/null || true
}

case "${1:-estado}" in
  estado|"")   estado ;;
  registro)    registro "${2:-60}" ;;
  reiniciar)   reiniciar ;;
  actualizar)  actualizar "${2:-}" ;;
  clave)       shift; estudio-clave "$@" ;;
  https)       https ;;
  repositorio) repositorio "${2:-}" ;;
  probar)      shift; probar "$@" ;;
  -h|--help|ayuda) sed -n '5,17p' "$0" | sed 's/^#  \{0,1\}//' ;;
  *) echo "No entiendo «$1». Prueba:  asvs ayuda"; exit 1 ;;
esac
